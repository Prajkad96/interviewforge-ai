# INTERVIEWFORGE AI Environment Configuration

# Flask Secret Key
SECRET_KEY=interviewforge-super-secret-key-2026

# Groq Cloud API Key (Get 100% Free at https://console.groq.com/keys)
GROQ_API_KEY=your_free_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Database Configuration (Defaults to SQLite; configure MySQL if desired)
# DATABASE_URL=mysql+mysqlconnector://root:password@localhost/interviewforge
DATABASE_URL=sqlite:///interviewforge.db

# Server Port
PORT=5000
